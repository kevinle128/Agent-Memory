# OpenAI-compatible endpoint: fill these three values, then docker compose up -d
MEMORY_LLM_BASE_URL=https://api.openai.com/v1
MEMORY_LLM_API_KEY=
MEMORY_LLM_MODEL=
BIND_ADDRESS=127.0.0.1
MEMORY_CORE_PORT=8420
PANEL_PORT=8125
KNOWLEDGE_PORT=8424
PROXY_PORT=8096
MEMORY_CORE_GATEWAY_API_KEY=
KNOWLEDGE_SERVICE_KEY=replace-with-another-random-secret
# Bearer key for Proxy admin endpoints (/v3/admin/*, /v3/instance/proxy-destroy).
# Empty leaves these endpoints open to anyone who can reach the proxy port.
TDAI_PROXY_ADMIN_API_KEY=replace-with-a-third-random-secret

# Local source build revision (image tag)
MEMORY_BUILD_REVISION=9e62e5d

# Core stays bound to localhost; the proxy reaches it on the compose network.
CORE_BIND_ADDRESS=127.0.0.1
# Core image with quota refresh fix
MEMORY_CORE_IMAGE=agent-memory/core:9e62e5d-quota-fix

# Optional image override for updating Proxy independently.
MEMORY_PROXY_IMAGE=

# Langfuse project credentials; local JSONL trace archive is independently controlled.
PROXY_LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
PROXY_TRACE_ARCHIVE_ENABLED=false
